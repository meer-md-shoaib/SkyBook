# ------------------------------------------------------------------
# SkyBook environment configuration (copy to .env and edit)
# ------------------------------------------------------------------
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# MySQL / MariaDB connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skybook_db
# Used by the pytest suite
TEST_DB_NAME=skybook_test_db

# Business rules
SEAT_HOLD_MINUTES=10
CANCELLATION_FEE_PERCENT=10
TICKET_OUTPUT_DIR=generated_tickets
